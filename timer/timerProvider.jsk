import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState } from 'react';
import { base44 } from '@/api/base44Client';
import { dayKey } from '@/lib/time';
import { completionMessages } from '@/data/verses';

const STORAGE_KEY = 'faith-focus-timer-v1';
const DEFAULTS = { focus: 25, short: 5, long: 15, longEvery: 4 };
const TimerContext = createContext(null);

function secondsFor(mode, durations) {
  if (mode === 'short') return durations.short * 60;
  if (mode === 'long') return durations.long * 60;
  return durations.focus * 60;
}

function buildInitial() {
  const base = {
    mode: 'focus',
    durations: { ...DEFAULTS },
    completedInCycle: 0,
    task: '',
    remaining: DEFAULTS.focus * 60,
    running: false,
    endsAt: null,
  };
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
    if (!saved) return base;
    const durations = { ...DEFAULTS, ...(saved.durations || {}) };
    const stillRunning = Boolean(saved.running && saved.endsAt);
    const remaining = stillRunning
      ? Math.max(0, Math.round((saved.endsAt - Date.now()) / 1000))
      : Math.max(0, Number(saved.remaining) || secondsFor(saved.mode || 'focus', durations));
    return {
      mode: saved.mode || 'focus',
      durations,
      completedInCycle: Number(saved.completedInCycle) || 0,
      task: saved.task || '',
      remaining,
      running: stillRunning && remaining > 0,
      endsAt: stillRunning && remaining > 0 ? saved.endsAt : null,
    };
  } catch {
    return base;
  }
}

export function TimerProvider({ children }) {
  const [state, setState] = useState(buildInitial);
  const [breakOpen, setBreakOpen] = useState(false);
  const [notice, setNotice] = useState(null);
  const [sessionTick, setSessionTick] = useState(0);
  const stateRef = useRef(state);
  const finishingRef = useRef(false);
  stateRef.current = state;

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      /* storage unavailable */
    }
  }, [state]);

  const announce = useCallback((message) => setNotice({ id: Date.now(), message }), []);
  const dismissNotice = useCallback(() => setNotice(null), []);

  const finishPhase = useCallback(() => {
    const s = stateRef.current;
    const { durations } = s;

    if (s.mode === 'focus') {
      const cycle = s.completedInCycle + 1;
      const isLong = cycle >= durations.longEvery;
      const nextMode = isLong ? 'long' : 'short';
      base44.entities.StudySession.create({
        mode: 'focus',
        duration_minutes: durations.focus,
        task: s.task || 'Focus session',
        day_key: dayKey(),
        completed_at: new Date().toISOString(),
      })
        .then(() => setSessionTick((t) => t + 1))
        .catch(() => {});
      announce(completionMessages[Math.floor(Math.random() * completionMessages.length)]);
      setBreakOpen(true);
      setState((prev) => ({
        ...prev,
        mode: nextMode,
        remaining: secondsFor(nextMode, durations),
        endsAt: Date.now() + secondsFor(nextMode, durations) * 1000,
        running: true,
        completedInCycle: isLong ? durations.longEvery : cycle,
      }));
      return;
    }

    setBreakOpen(false);
    setState((prev) => ({
      ...prev,
      mode: 'focus',
      remaining: secondsFor('focus', durations),
      running: false,
      endsAt: null,
      completedInCycle: prev.mode === 'long' ? 0 : prev.completedInCycle,
    }));
    announce('Your break has ended. Take a breath, and return to your work when you are ready.');
  }, [announce]);

  useEffect(() => {
    if (!state.running || !state.endsAt) return undefined;
    const id = setInterval(() => {
      const current = stateRef.current;
      if (!current.endsAt) return;
      const remaining = Math.max(0, Math.round((current.endsAt - Date.now()) / 1000));
      if (remaining <= 0) {
        if (finishingRef.current) return;
        finishingRef.current = true;
        setState((prev) => ({ ...prev, remaining: 0, running: false, endsAt: null }));
        finishPhase();
        setTimeout(() => {
          finishingRef.current = false;
        }, 900);
        return;
      }
      setState((prev) => (prev.remaining === remaining ? prev : { ...prev, remaining }));
    }, 500);
    return () => clearInterval(id);
  }, [state.running, state.endsAt, finishPhase]);

  const start = useCallback(() => {
    setState((prev) => {
      const remaining = prev.remaining > 0 ? prev.remaining : secondsFor(prev.mode, prev.durations);
      return { ...prev, running: true, remaining, endsAt: Date.now() + remaining * 1000 };
    });
  }, []);

  const pause = useCallback(() => {
    setState((prev) => ({
      ...prev,
      running: false,
      remaining: prev.endsAt ? Math.max(0, Math.round((prev.endsAt - Date.now()) / 1000)) : prev.remaining,
      endsAt: null,
    }));
  }, []);

  const toggle = useCallback(() => {
    if (stateRef.current.running) pause();
    else start();
  }, [pause, start]);

  const reset = useCallback(() => {
    setState((prev) => ({
      ...prev,
      running: false,
      endsAt: null,
      remaining: secondsFor(prev.mode, prev.durations),
    }));
  }, []);

  const skip = useCallback(() => {
    const s = stateRef.current;
    if (s.mode === 'focus') {
      const goingLong = s.completedInCycle + 1 >= s.durations.longEvery;
      const nextMode = goingLong ? 'long' : 'short';
      setBreakOpen(true);
      setState((prev) => ({
        ...prev,
        mode: nextMode,
        remaining: secondsFor(nextMode, prev.durations),
        endsAt: Date.now() + secondsFor(nextMode, prev.durations) * 1000,
        running: true,
      }));
      return;
    }
    setBreakOpen(false);
    setState((prev) => ({
      ...prev,
      mode: 'focus',
      remaining: secondsFor('focus', prev.durations),
      running: false,
      endsAt: null,
      completedInCycle: prev.mode === 'long' ? 0 : prev.completedInCycle,
    }));
  }, []);

  const setTask = useCallback((task) => setState((prev) => ({ ...prev, task })), []);

  const applyDurations = useCallback((next) => {
    setState((prev) => {
      const durations = { ...prev.durations, ...next };
      return {
        ...prev,
        durations,
        remaining: prev.running ? prev.remaining : secondsFor(prev.mode, durations),
      };
    });
  }, []);

  const dismissBreak = useCallback(() => setBreakOpen(false), []);

  const total = secondsFor(state.mode, state.durations);
  const progress = total > 0 ? 1 - state.remaining / total : 0;

  const value = useMemo(
    () => ({
      ...state,
      total,
      progress,
      breakOpen,
      notice,
      sessionTick,
      announce,
      dismissNotice,
      start,
      pause,
      toggle,
      reset,
      skip,
      setTask,
      applyDurations,
      dismissBreak,
    }),
    [state, total, progress, breakOpen, notice, sessionTick, announce, dismissNotice, start, pause, toggle, reset, skip, setTask, applyDurations, dismissBreak]
  );

  return <TimerContext.Provider value={value}>{children}</TimerContext.Provider>;
}

export function useTimer() {
  const context = useContext(TimerContext);
  if (!context) throw new Error('useTimer must be used inside TimerProvider');
  return context;
}

export const phaseLabels = {
  focus: 'Focus session',
  short: 'Short break',
  long: 'Long break',
};
