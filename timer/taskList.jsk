import { useCallback, useEffect, useState } from 'react';
import { Check, Plus, Trash2 } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import { dayKey } from '@/lib/time';
import { useTimer } from '@/components/timer/TimerProvider';
import { toast } from '@/components/ui/use-toast';

export default function TaskList() {
  const { task, setTask } = useTimer();
  const [tasks, setTasks] = useState([]);
  const [draft, setDraft] = useState('');

  const load = useCallback(async () => {
    const result = await base44.entities.StudyTask.filter({ day_key: dayKey() }, { sort: '-created_date', limit: 30 });
    setTasks(result.items || []);
  }, []);

  useEffect(() => {
    load();
  }, [load]);

  const addTask = async (event) => {
    event.preventDefault();
    const title = draft.trim();
    if (!title) return;
    const created = await base44.entities.StudyTask.create({ title, day_key: dayKey(), done: false });
    setTasks((prev) => [created, ...prev]);
    setDraft('');
    if (!task) setTask(title);
  };

  const toggleDone = async (item) => {
    const next = !item.done;
    setTasks((prev) => prev.map((t) => (t.id === item.id ? { ...t, done: next } : t)));
    try {
      await base44.entities.StudyTask.update(item.id, { done: next });
    } catch (error) {
      setTasks((prev) => prev.map((t) => (t.id === item.id ? { ...t, done: item.done } : t)));
      toast({
        title: 'Could not update that goal',
        description: error?.message,
        variant: 'destructive',
      });
    }
  };

  const removeTask = async (id) => {
    const snapshot = tasks;
    setTasks((prev) => prev.filter((t) => t.id !== id));
    try {
      await base44.entities.StudyTask.delete(id);
    } catch (error) {
      setTasks(snapshot);
      toast({
        title: 'Could not delete that goal',
        description: error?.message,
        variant: 'destructive',
      });
    }
  };

  return (
    <div className="surface px-5 py-5">
      <div className="flex items-center justify-between">
        <span className="eyebrow">Today&apos;s study goals</span>
        <span className="text-[11px] text-muted-foreground">
          {tasks.filter((t) => t.done).length}/{tasks.length} done
        </span>
      </div>

      <form onSubmit={addTask} className="mt-3 flex items-center gap-2">
        <input
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          placeholder="What are you studying?"
          className="w-full rounded-xl border border-border/70 bg-background/60 px-3 py-2 text-sm outline-none transition focus:border-primary/50"
        />
        <button
          type="submit"
          aria-label="Add task"
          className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-foreground transition hover:bg-primary/90 lg:h-9 lg:w-9"
        >
          <Plus className="h-4 w-4" />
        </button>
      </form>

      <ul className="mt-3 space-y-1.5">
        {tasks.length === 0 && (
          <li className="rounded-xl border border-dashed border-border/70 px-3 py-4 text-center text-sm text-muted-foreground lg:text-xs">
            Add a study goal to focus on.
          </li>
        )}
        {tasks.map((item) => {
          const active = task === item.title;
          return (
            <li
              key={item.id}
              className={`group flex items-center gap-2 rounded-xl px-2.5 py-2 transition ${
                active ? 'bg-primary/8' : 'hover:bg-secondary/50'
              }`}
            >
              <button
                type="button"
                onClick={() => toggleDone(item)}
                aria-label="Toggle task"
                className="-ml-2 flex h-11 w-11 shrink-0 items-center justify-center lg:ml-0 lg:h-5 lg:w-5"
              >
                <span
                  className={`flex h-5 w-5 items-center justify-center rounded-full border transition ${
                    item.done ? 'border-primary bg-primary text-primary-foreground' : 'border-border'
                  }`}
                >
                  {item.done && <Check className="h-3 w-3" />}
                </span>
              </button>
              <button
                type="button"
                onClick={() => setTask(item.title)}
                className="flex-1 truncate text-left text-sm"
              >
                <span className={item.done ? 'text-muted-foreground line-through' : 'text-foreground/90'}>
                  {item.title}
                </span>
                {active && <span className="ml-2 text-[10px] uppercase tracking-widest text-primary">now</span>}
              </button>
              <button
                type="button"
                onClick={() => removeTask(item.id)}
                aria-label="Delete task"
                className="-mr-2 flex h-11 w-11 items-center justify-center text-muted-foreground transition lg:mr-0 lg:h-auto lg:w-auto lg:opacity-0 lg:group-hover:opacity-100"
              >
                <Trash2 className="h-3.5 w-3.5" />
              </button>
            </li>
          );
        })}
      </ul>
    </div>
  );
}
